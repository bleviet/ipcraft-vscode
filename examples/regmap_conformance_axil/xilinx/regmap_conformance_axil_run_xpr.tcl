# Vivado full synthesis + implementation for regmap_conformance_axil
# Generated by IPCraft
#
# Usage (from the xilinx/ directory):
#   vivado -mode batch -source regmap_conformance_axil_run_xpr.tcl -nojournal -nolog
#   vivado -mode batch -source regmap_conformance_axil_run_xpr.tcl -nojournal -nolog -tclargs 8
#
# Optional argument: number of parallel jobs (default 4).
# Reports are written to xilinx/build/xpr/.

set script_dir   [file normalize [file dirname [info script]]]
set project_name regmap_conformance_axil
set project_dir  [file join $script_dir build xpr]
set part         xc7z020clg484-1
set jobs         [expr {[llength $argv] > 0 ? int([lindex $argv 0]) : 4}]

puts "=== IPCraft: Synthesis + Implementation — regmap_conformance_axil ==="
puts "Part      : $part"
puts "Build dir : $project_dir"
puts "Jobs      : $jobs"

# Gracefully handle already open projects to avoid locking errors
if {[current_project -quiet] ne ""} {
    puts "Closing currently open project: [current_project]"
    close_project
}

if {[file exists $project_dir]} {
    puts "Removing existing build: $project_dir"
    file delete -force $project_dir
}

create_project $project_name $project_dir -part $part

# ---- IP Repository -------------------------------------------------------
# Register this directory as an IP repository so block designs can discover
# the generated component.xml when this IP is instantiated.
set_property IP_REPO_PATHS [list $script_dir] [current_project]
update_ip_catalog -rebuild -quiet

# ---- RTL sources --------------------------------------------------------
add_files -fileset sources_1 -norecurse [file normalize [file join $script_dir ../rtl/regmap_conformance_axil_pkg.vhd]]
add_files -fileset sources_1 -norecurse [file normalize [file join $script_dir ../rtl/regmap_conformance_axil_regs.vhd]]
add_files -fileset sources_1 -norecurse [file normalize [file join $script_dir ../rtl/regmap_conformance_axil_axil.vhd]]
add_files -fileset sources_1 -norecurse [file normalize [file join $script_dir ../rtl/regmap_conformance_axil.vhd]]
add_files -fileset sources_1 -norecurse [file normalize [file join $script_dir ../rtl/regmap_conformance_axil_core.vhd]]

# Use VHDL-2008 for VHDL source files (skipped when project contains only SystemVerilog)
# Uses FILE_TYPE filter to capture both .vhd and .vhdl safely
set vhd_files [get_files -quiet -filter {FILE_TYPE =~ "VHDL*"}]
if {[llength $vhd_files] > 0} {
    set_property file_type {VHDL 2008} $vhd_files
}

# ---- Constraints ---------------------------------------------------------
# Standard (non-OOC) XDC — same clock constraints, used for implementation
add_files -fileset constrs_1 \
    [file normalize [file join $script_dir regmap_conformance_axil_ooc.xdc]]

set_property top regmap_conformance_axil [current_fileset]
update_compile_order -fileset sources_1

# ---- Synthesis ----------------------------------------------------------
puts "\n--- Launching synthesis ---"
launch_runs synth_1 -jobs $jobs
wait_on_run synth_1

set synth_status [get_property STATUS [get_runs synth_1]]
puts "Synthesis status: $synth_status"
if {[string match "*error*" [string tolower $synth_status]] || [get_property PROGRESS [get_runs synth_1]] ne "100%"} {
    puts "ERROR: Synthesis failed or did not complete successfully."
    exit 1
}

# ---- Implementation -----------------------------------------------------
puts "\n--- Launching implementation ---"
launch_runs impl_1 -jobs $jobs
wait_on_run impl_1

set impl_status [get_property STATUS [get_runs impl_1]]
puts "Implementation status: $impl_status"
if {[string match "*error*" [string tolower $impl_status]] || [get_property PROGRESS [get_runs impl_1]] ne "100%"} {
    puts "ERROR: Implementation failed or did not complete successfully."
    exit 1
}

# ---- Reports ------------------------------------------------------------
puts "\n--- Generating reports ---"
open_run impl_1 -name impl_1

report_timing_summary \
    -file            [file join $project_dir timing.rpt] \
    -warn_on_violation

report_utilization \
    -file            [file join $project_dir utilization.rpt]

catch {
    report_cdc -file [file join $project_dir cdc.rpt]
}

puts "\n=== Implementation complete ==="
puts "Reports: $project_dir"
puts "Project: [file join $project_dir ${project_name}.xpr]"
exit
