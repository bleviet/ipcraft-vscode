          <spirit:description>Free-running liveness counter and watchdog-alive status. The hardware runner reads this register twice to prove that the peripheral clock is advancing after configuration.
</spirit:description>
          <spirit:addressOffset>0x50</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-only</spirit:access>
          <spirit:field>
