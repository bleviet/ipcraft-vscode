  <spirit:memoryMaps>
    <spirit:memoryMap>
      <spirit:name>REGMAP_CONFORMANCE_AXIL_CSR</spirit:name>
      <spirit:addressBlock>
        <spirit:name>CSR</spirit:name>
        <spirit:baseAddress spirit:format="long">0</spirit:baseAddress>
        <spirit:range spirit:format="long">88</spirit:range>
        <spirit:width spirit:format="long">32</spirit:width>
        <spirit:usage>register</spirit:usage>
        <spirit:register>
          <spirit:name>ID</spirit:name>
          <spirit:description>Fixed magic/version constant -- RO constant readback self-test</spirit:description>
          <spirit:addressOffset>0x0</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-only</spirit:access>
          <spirit:reset>
            <spirit:value spirit:format="long">0xC0FFEE01</spirit:value>
          </spirit:reset>
          <spirit:field>
            <spirit:name>MAGIC</spirit:name>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">32</spirit:bitWidth>
            <spirit:access>read-only</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>SCRATCH</spirit:name>
          <spirit:description>Plain RW round-trip register, also used for the byte-strobe test</spirit:description>
          <spirit:addressOffset>0x4</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-write</spirit:access>
          <spirit:field>
            <spirit:name>VALUE</spirit:name>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">32</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>STIMULUS</spirit:name>
          <spirit:description>Software-writable loopback control. The hand-written core wires these bits into the register file's hardware-side inputs, making every hardware-dependent access type triggerable from the bus.
</spirit:description>
          <spirit:addressOffset>0x8</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-write</spirit:access>
          <spirit:field>
            <spirit:name>STATUS_VAL</spirit:name>
            <spirit:description>Passed straight through to STATUS.VALUE</spirit:description>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">4</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
          <spirit:field>
            <spirit:name>SAMPLE_EVT_TRIG</spirit:name>
            <spirit:description>Rising edge pulses INT_STATUS.SAMPLE_EVT (HW set)</spirit:description>
            <spirit:bitOffset>4</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
          <spirit:field>
            <spirit:name>ERROR_EVT_TRIG</spirit:name>
            <spirit:description>Rising edge pulses INT_STATUS.ERROR_EVT (HW set)</spirit:description>
            <spirit:bitOffset>5</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
          <spirit:field>
            <spirit:name>LEGACY_TRIG</spirit:name>
            <spirit:description>Rising edge pulses IRQ_LEGACY.FLAG (HW set)</spirit:description>
            <spirit:bitOffset>6</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
          <spirit:field>
            <spirit:name>CMD_DONE_TRIG</spirit:name>
            <spirit:description>Rising edge auto-clears COMMAND.START (HW self-clear)</spirit:description>
            <spirit:bitOffset>7</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
          <spirit:field>
            <spirit:name>BUSY_DONE_TRIG</spirit:name>
            <spirit:description>Rising edge auto-clears BUSY.ACTIVE (HW self-clear)</spirit:description>
            <spirit:bitOffset>8</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
          <spirit:field>
            <spirit:name>LINK_SPEED</spirit:name>
            <spirit:description>Passed straight through to LINK.SPEED (drives change-of-state)</spirit:description>
            <spirit:bitOffset>9</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">4</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>STATUS</spirit:name>
          <spirit:description>RO status sourced live from STIMULUS.STATUS_VAL via the core</spirit:description>
          <spirit:addressOffset>0xC</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-only</spirit:access>
          <spirit:field>
            <spirit:name>VALUE</spirit:name>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">4</spirit:bitWidth>
            <spirit:access>read-only</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>INT_STATUS</spirit:name>
          <spirit:description>Multi-bit sticky interrupt flags. HW pulse (from STIMULUS trigger bits) sets a bit; SW clears by writing 1. HW-set beats a simultaneous SW-clear on the ground-truth register file.
</spirit:description>
          <spirit:addressOffset>0x10</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-write</spirit:access>
          <spirit:field>
            <spirit:name>SAMPLE_EVT</spirit:name>
            <spirit:description>Set by a rising edge on STIMULUS.SAMPLE_EVT_TRIG</spirit:description>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
          <spirit:field>
            <spirit:name>ERROR_EVT</spirit:name>
            <spirit:description>Set by a rising edge on STIMULUS.ERROR_EVT_TRIG</spirit:description>
            <spirit:bitOffset>1</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>IRQ_LEGACY</spirit:name>
          <spirit:description>Plain (non-readable) W1C -- reads back 0 regardless of state</spirit:description>
          <spirit:addressOffset>0x14</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-write</spirit:access>
          <spirit:field>
            <spirit:name>FLAG</spirit:name>
            <spirit:description>Set by a rising edge on STIMULUS.LEGACY_TRIG</spirit:description>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>COMMAND</spirit:name>
          <spirit:description>SW sets, HW clears (self-clear beats a lingering SW set); reads 0</spirit:description>
          <spirit:addressOffset>0x18</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>write-only</spirit:access>
          <spirit:field>
            <spirit:name>START</spirit:name>
            <spirit:description>Cleared by a rising edge on STIMULUS.CMD_DONE_TRIG</spirit:description>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>write-only</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>BUSY</spirit:name>
          <spirit:description>As COMMAND, but readable while set</spirit:description>
          <spirit:addressOffset>0x1C</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-write</spirit:access>
          <spirit:field>
            <spirit:name>ACTIVE</spirit:name>
            <spirit:description>Cleared by a rising edge on STIMULUS.BUSY_DONE_TRIG</spirit:description>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>DIAG</spirit:name>
          <spirit:description>Write-only diagnostic scratch -- reads 0, but the value reaches hardware</spirit:description>
          <spirit:addressOffset>0x20</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>write-only</spirit:access>
          <spirit:field>
            <spirit:name>SCRATCH</spirit:name>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">8</spirit:bitWidth>
            <spirit:access>write-only</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>WO_MIRROR</spirit:name>
          <spirit:description>Readable echo of DIAG.SCRATCH -- confirms the WO value landed in hardware</spirit:description>
          <spirit:addressOffset>0x24</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-only</spirit:access>
          <spirit:field>
            <spirit:name>SCRATCH</spirit:name>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">8</spirit:bitWidth>
            <spirit:access>read-only</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>LINK</spirit:name>
          <spirit:description>Mixed register -- RO live field plus a change-of-state W1C flag</spirit:description>
          <spirit:addressOffset>0x28</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-write</spirit:access>
          <spirit:field>
            <spirit:name>SPEED</spirit:name>
            <spirit:description>Sourced live from STIMULUS.LINK_SPEED via the core</spirit:description>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">4</spirit:bitWidth>
            <spirit:access>read-only</spirit:access>
          </spirit:field>
          <spirit:field>
            <spirit:name>SPEED_CHANGED</spirit:name>
            <spirit:description>Set whenever SPEED changes value; write 1 to clear; no event at reset</spirit:description>
            <spirit:bitOffset>8</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">1</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>CONTROL</spirit:name>
          <spirit:description>RW register with an enumerated field and a non-zero reset value</spirit:description>
          <spirit:addressOffset>0x2C</spirit:addressOffset>
          <spirit:size spirit:format="long">32</spirit:size>
          <spirit:access>read-write</spirit:access>
          <spirit:reset>
            <spirit:value spirit:format="long">0x1</spirit:value>
          </spirit:reset>
          <spirit:field>
            <spirit:name>MODE</spirit:name>
            <spirit:bitOffset>0</spirit:bitOffset>
            <spirit:bitWidth spirit:format="long">2</spirit:bitWidth>
            <spirit:access>read-write</spirit:access>
          </spirit:field>
        </spirit:register>
        <spirit:register>
          <spirit:name>CHANNEL_0_CONFIG</spirit:name>
