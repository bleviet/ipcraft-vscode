{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Files reached only through a runtime string path (fs.readFileSync,
  // extensionTestsPath, npm lifecycle scripts in packages/ipcraft, a
  // devtools-console snippet) rather than an import knip can trace statically.
  // config/webpack.config.js is NOT listed here — knip's webpack plugin
  // auto-discovers it and derives the extension/cli/webview entries from its
  // `entry: {...}` field.
  "entry": [
    "src/test/e2e/runTests.ts",
    "src/test/e2e/suite/index.ts",
    "config/postcss.config.js",
    "config/tailwind.config.js",
    "scripts/prepare-cli-package.js",
    "scripts/guard-cli-publish.js",
    "scripts/docs-screenshots/theme/dump-theme.js"
  ],
  "ignore": [
    // Git submodule with its own repo/lifecycle, not part of this project.
    "ipcraft-spec/**",
    // Read via fs.readFileSync(path), not imported.
    "scripts/docs-screenshots/theme/*.css",
    // Generated by `npm run generate-types` from ipcraft-spec JSON schemas;
    // per CLAUDE.md these are never hand-edited, so per-export dead-code
    // noise here isn't actionable.
    "src/domain/ipcore.types.ts",
    "src/generator/contract/templateContext.types.ts"
  ],
  "ignoreDependencies": [
    // Ambient type-only package for the `vscode` module specifier; never
    // imported by name.
    "@types/vscode",
    // Referenced only as a bare `autoprefixer: {}` plugin key in
    // config/postcss.config.js; knip's postcss plugin doesn't resolve
    // config files outside the conventional root location.
    "autoprefixer"
  ],
  "ignoreBinaries": [
    // External EDA/doc toolchains shelled out to by integration tests and
    // docs scripts, not npm-installed.
    "ghdl",
    "iverilog",
    "verilator",
    "vvp",
    "xmllint",
    "make",
    "vivado",
    "mkdocs"
  ]
}
