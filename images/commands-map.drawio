<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;IPCraft command map&lt;/b&gt;&lt;br&gt;Start on the left, follow the arrows to the right. Every command is in the Command Palette under IPCraft." style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="50" as="geometry"/></mxCell><mxCell id="create" value="&lt;b&gt;1. Create&lt;/b&gt;&lt;br&gt;New IP Core&lt;br&gt;New Register Map&lt;br&gt;New IP Core + Register Map" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="110" as="geometry"/></mxCell><mxCell id="import" value="&lt;b&gt;1. Import (Experimental)&lt;/b&gt;&lt;br&gt;from VHDL&lt;br&gt;from Altera Platform Designer (_hw.tcl)&lt;br&gt;from Xilinx Component XML" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="320" height="110" as="geometry"/></mxCell><mxCell id="migrate" value="&lt;b&gt;Migrate&lt;/b&gt;&lt;br&gt;Migrate Legacy IP Cores&lt;br&gt;(vendor: to targets:)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="320" height="80" as="geometry"/></mxCell><mxCell id="preview" value="&lt;b&gt;Preview source (Ctrl+Shift+V)&lt;/b&gt;&lt;br&gt;On .vhd, .v, .sv, _hw.tcl,&lt;br&gt;or component.xml:&lt;br&gt;Preview in IPCraft (read-only),&lt;br&gt;then Save as .ip.yml" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="320" height="130" as="geometry"/></mxCell><mxCell id="spec" value="&lt;b&gt;2. Specification files&lt;/b&gt;&lt;br&gt;*.ip.yml and *.mm.yml&lt;br&gt;&lt;br&gt;Editor mode&lt;br&gt;(Ctrl+Shift+V toggles):&lt;br&gt;Open as Text Editor&lt;br&gt;Open as Visual Editor&lt;br&gt;Preview in IPCraft (Experimental)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#FEF9C3;strokeColor=#CA8A04;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="280" height="290" as="geometry"/></mxCell><mxCell id="misc" value="&lt;b&gt;Browse and help&lt;/b&gt;&lt;br&gt;View Bus Definitions&lt;br&gt;Scan Workspace Bus Definitions&lt;br&gt;Copy Component Instance&lt;br&gt;Open Walkthrough...&lt;br&gt;Open Extension Settings&lt;br&gt;Report Issue / Send Feedback" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="440" y="520" width="280" height="150" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;3. Scaffold and Generate&lt;/b&gt;&lt;br&gt;Scaffold Project (all-in-one)&lt;br&gt;Generate Top-Level HDL&lt;br&gt;Generate CocoTB Testbench&lt;br&gt;Generate Vivado Project&lt;br&gt;Generate Quartus Project&lt;br&gt;Generate Platform Designer Component&lt;br&gt;Generate Vivado Component (component.xml)&lt;br&gt;Generate and Build (Vivado OOC / Quartus)&lt;br&gt;Generate Documentation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="350" height="300" as="geometry"/></mxCell><mxCell id="packs" value="&lt;b&gt;Customize output: Scaffold Packs&lt;/b&gt;&lt;br&gt;Preview Template Output&lt;br&gt;Pin Preview IP Core&lt;br&gt;Export Built-in Scaffold Pack" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="800" y="440" width="350" height="110" as="geometry"/></mxCell><mxCell id="val" value="&lt;b&gt;4. Validate&lt;/b&gt;&lt;br&gt;Check Consistency&lt;br&gt;Check HDL Consistency (managed:false)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1230" y="100" width="320" height="90" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;5. Build&lt;/b&gt;&lt;br&gt;Build&lt;br&gt;Build: Vivado OOC Synthesis&lt;br&gt;Build: Quartus Compile&lt;br&gt;Show Build Output" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1230" y="220" width="320" height="120" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;6. Open in vendor tools&lt;/b&gt;&lt;br&gt;Open in Vivado / Open in Quartus&lt;br&gt;Edit in IP Packager&lt;br&gt;Open in Platform Designer&lt;br&gt;Scan Vivado IP Catalog&lt;br&gt;Scan Vivado Interface Catalog" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1230" y="370" width="320" height="160" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#6B7280;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.1;exitDx=0;exitDy=0;entryDx