# Vivado block-design discovery script generated by IPCraft.
# It intentionally writes a JSON file so callers never need to parse console output.

set recreate_script "{{ recreateScript }}"
set expected_design_name "{{ designName }}"
set manifest_path "{{ manifestPath }}"
set work_dir "{{ workDir }}"

file delete -force $work_dir
file mkdir $work_dir
cd $work_dir

# The recreation Tcl owns block-design construction. Source it before querying
# any block-design objects so discovery observes the recreated design only.
source $recreate_script

set actual_design_name [current_bd_design -quiet]
if {$expected_design_name ne "" && $actual_design_name ne $expected_design_name} {
    error "Expected block design '$expected_design_name', found '$actual_design_name'"
}

proc json_escape {value} {
    return [string map [list \\ \\\\ \" \\\" \n \\n \r \\r \t \\t] $value]
}

proc json_string {value} {
    return "\"[json_escape $value]\""
}

proc json_array {values} {
    return "\[[join $values ,]\]"
}

proc canonical_path {object} {
    set object_path [get_property PATH $object]
    if {$object_path eq ""} {
        set object_path "$object"
    }
    if {$object_path eq ""} {
        set object_path [get_property NAME $object]
    }
    if {![string match "/*" $object_path]} {
        set object_path "/$object_path"
    }
    return $object_path
}

proc property_or_empty {property object} {
    set value [get_property -quiet $property $object]
    return [expr {$value eq "" ? "" : $value}]
}

proc integer_property_or_zero {property object} {
    set value [property_or_empty $property $object]
    if {$value eq ""} {
        return 0
    }
    if {[scan $value %i parsed] != 1} {
        return 0
    }
    return $parsed
}

proc port_direction {port} {
    switch -nocase -- [property_or_empty DIR $port] {
        I { return in }
        O { return out }
        IO { return inout }
        default { return inout }
    }
}

proc port_width {port} {
    set left [property_or_empty LEFT $port]
    set right [property_or_empty RIGHT $port]
    if {$left eq "" || $right eq ""} {
        return 1
    }
    return [expr {abs(int($left) - int($right)) + 1}]
}

proc vhdl_wrapper_ports {wrapper_file} {
    set handle [open $wrapper_file r]
    set contents [read $handle]
    close $handle
    set ports [dict create]
    set in_entity_ports false
    foreach line [split $contents "\n"] {
        if {!$in_entity_ports} {
            if {[regexp -nocase {^\s*port\s*\(\s*$} $line]} {
                set in_entity_ports true
            }
            continue
        }
        if {[regexp {^\s*\);\s*$} $line]} {
            break
        }
        if {[regexp -nocase {^\s*([[:alnum:]_]+)\s*:\s*(in|out|inout)\s+std_logic_vector\s*\(\s*([0-9]+)\s+(downto|to)\s+([0-9]+)\s*\)} $line -> name direction left ordering right]} {
            dict set ports $name [list [string tolower $direction] [expr {abs($left - $right) + 1}] true]
        } elseif {[regexp -nocase {^\s*([[:alnum:]_]+)\s*:\s*(in|out|inout)\s+std_logic\s*;?\s*$} $line -> name direction]} {
            dict set ports $name [list [string tolower $direction] 1 false]
        }
    }
    return $ports
}

set wrapper_language [property_or_empty TARGET_LANGUAGE [current_project]]
set wrapper_ports [dict create]
if {[string equal -nocase $wrapper_language VHDL]} {
    set design_files [get_files -quiet ${actual_design_name}.bd]
    if {[llength $design_files] != 1} {
        error "Expected one ${actual_design_name}.bd for wrapper discovery, found [llength $design_files]"
    }
    generate_target all [lindex $design_files 0]
    set wrapper_files [make_wrapper -files [lindex $design_files 0] -top -force]
    set vhdl_wrappers [lsearch -all -inline -glob $wrapper_files *.vhd]
    if {[llength $vhdl_wrappers] != 1} {
        error "Expected one generated VHDL wrapper, found [llength $vhdl_wrappers]"
    }
    set wrapper_ports [vhdl_wrapper_ports [lindex $vhdl_wrappers 0]]
}

set boundary_interface_json {}
foreach boundary [get_bd_intf_ports -quiet] {
    set boundary_path [canonical_path $boundary]
    set boundary_name [get_property NAME $boundary]
    set protocol [property_or_empty CONFIG.PROTOCOL $boundary]
    set address_width [integer_property_or_zero CONFIG.ADDR_WIDTH $boundary]
    set data_width [integer_property_or_zero CONFIG.DATA_WIDTH $boundary]
    # GPIO, IIC, UART, and similar boundary interfaces are not addressable bus
    # boundaries and therefore are not candidates for system verification.
    if {$protocol eq "" || $address_width <= 0 || $data_width <= 0} {
        continue
    }
    set signal_json {}
    set prefix "${boundary_name}_"
    foreach wrapper_port [dict keys $wrapper_ports "${prefix}*"] {
        set signal_name [string range $wrapper_port [string length $prefix] end]
        lassign [dict get $wrapper_ports $wrapper_port] direction width is_vector
        lappend signal_json [format {% raw %}{{"name":%s,"direction":%s,"width":%d}}{% endraw %} \
            [json_string [string tolower $signal_name]] \
            [json_string $direction] \
            $width]
    }
    lappend boundary_interface_json [format {% raw %}{{"path":%s,"mode":%s,"protocol":%s,"addressWidth":%d,"dataWidth":%d,"signals":%s}}{% endraw %} \
        [json_string $boundary_path] \
        [json_string [property_or_empty MODE $boundary]] \
        [json_string $protocol] \
        $address_width \
        $data_width \
        [json_array $signal_json]]
}

set boundary_port_json {}
foreach boundary [get_bd_ports -quiet] {
    if {[string equal -nocase [property_or_empty INTF $boundary] TRUE]} {
        continue
    }
    set vivado_type [string tolower [property_or_empty TYPE $boundary]]
    set normalized_type [expr {$vivado_type eq "clk" ? "clock" : ($vivado_type eq "rst" ? "reset" : "data")}]
    set wrapper_port_name [get_property NAME $boundary]
    if {[dict exists $wrapper_ports $wrapper_port_name]} {
        lassign [dict get $wrapper_ports $wrapper_port_name] wrapper_direction wrapper_width wrapper_is_vector
    } else {
        set wrapper_direction [port_direction $boundary]
        set wrapper_width [port_width $boundary]
    }
    lappend boundary_port_json [format {% raw %}{{"path":%s,"type":%s,"direction":%s,"width":%d}}{% endraw %} \
        [json_string [canonical_path $boundary]] \
        [json_string $normalized_type] \
        [json_string $wrapper_direction] \
        $wrapper_width]
}

set wrapper_port_json {}
foreach wrapper_port [dict keys $wrapper_ports] {
    lassign [dict get $wrapper_ports $wrapper_port] direction width is_vector
    lappend wrapper_port_json [format {% raw %}{{"name":%s,"direction":%s,"width":%d,"isVector":%s}}{% endraw %} \
        [json_string $wrapper_port] \
        [json_string $direction] \
        $width \
        $is_vector]
}

set instances {}
foreach cell [get_bd_cells -quiet -hier] {
    lappend instances [json_string [canonical_path $cell]]
}

set route_json {}
foreach boundary [get_bd_intf_ports -quiet] {
    set boundary_path [canonical_path $boundary]
    set protocol [property_or_empty CONFIG.PROTOCOL $boundary]
    set address_width [integer_property_or_zero CONFIG.ADDR_WIDTH $boundary]
    set data_width [integer_property_or_zero CONFIG.DATA_WIDTH $boundary]
    set bus_bytes [expr {$data_width > 0 ? $data_width / 8 : 0}]
    set address_space [get_bd_addr_spaces -quiet $boundary_path]
    if {[llength $address_space] != 1} {
        continue
    }

    foreach mapped_segment [get_bd_addr_segs -quiet -of_objects $address_space] {
        set slave_segments [get_bd_addr_segs -quiet -of_objects $mapped_segment]
        if {[llength $slave_segments] != 1} {
            continue
        }
        set slave_segment [lindex $slave_segments 0]
        set slave_pins [get_bd_intf_pins -quiet -of_objects $slave_segment]
        if {[llength $slave_pins] != 1} {
            continue
        }
        set pin [lindex $slave_pins 0]
        set cell [lindex [get_bd_cells -quiet -of_objects $pin] 0]
        set instance_path [canonical_path $cell]
        set base_address [integer_property_or_zero OFFSET $mapped_segment]
        set address_range [integer_property_or_zero RANGE $mapped_segment]
        if {$cell eq "" || $bus_bytes <= 0 || $address_width <= 0 || $address_range <= 0} {
            continue
        }
        lappend route_json [format {% raw %}{{"driveInterfacePath":%s,"instancePath":%s,"protocol":%s,"baseAddress":%d,"addressRange":%d,"busBytes":%d,"addressWidth":%d,"addressSegmentPath":%s,"mappedSegmentPath":%s}}{% endraw %} \
            [json_string $boundary_path] \
            [json_string $instance_path] \
            [json_string $protocol] \
            $base_address \
            $address_range \
            $bus_bytes \
            $address_width \
            [json_string [canonical_path $slave_segment]] \
            [json_string [canonical_path $mapped_segment]]]
    }
}

set manifest [format {"designName":%s,"wrapperLanguage":%s,"boundaryInterfaces":%s,"boundaryPorts":%s,"wrapperPorts":%s,"instancePaths":%s,"axiRoutes":%s} \
    [json_string $actual_design_name] \
    [json_string $wrapper_language] \
    [json_array $boundary_interface_json] \
    [json_array $boundary_port_json] \
    [json_array $wrapper_port_json] \
    [json_array $instances] \
    [json_array $route_json]]

set output [open $manifest_path w]
puts $output "{$manifest}"
close $output
exit
