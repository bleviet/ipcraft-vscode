# Synthetic sample for IPCraft system viewer performance and UI/UX checks.
# Generated by scripts/generate-system-samples.js; not exported from Vivado.

set scripts_vivado_version 2024.2

variable design_name
set design_name vivado_dsp_soc_64ch
create_bd_design $design_name
current_bd_design $design_name

# Hierarchical cell: dsp
proc create_hier_cell_ch0_dsp { parentCell nameHier } {
  set parentObj [get_bd_cells $parentCell]
  set oldCurInst [current_bd_instance .]
  current_bd_instance $parentObj
  set hier_obj [create_bd_cell -type hier $nameHier]
  current_bd_instance $hier_obj

  create_bd_intf_pin -mode Slave -vlnv xilinx.com:interface:axis_rtl:1.0 S_AXIS
  create_bd_intf_pin -mode Master -vlnv xilinx.com:interface:axis_rtl:1.0 M_AXIS
  create_bd_pin -dir I -type clk aclk
  create_bd_pin -dir I -type rst aresetn

  set in_fifo [ create_bd_cell -type ip -vlnv xilinx.com:ip:axis_data_fifo:2.0 in_fifo ]
  set_property -dict [list \
    CONFIG.FIFO_DEPTH {1024} \
  ] $in_fifo

  set fir [ create_bd_cell -type ip -vlnv xilinx.com:ip:fir_compiler:7.2 fir ]
  set_property -dict [list \
    CONFIG.Data_Width {16} \
    CONFIG.Coefficient_Width {16} \
  ] $fir

  set gain [ create_bd_cell -type module -reference gain_stage gain ]
  set_property -dict [list \
    CONFIG.GAIN_WIDTH {12} \
  ] $gain


  connect_bd_intf_net -intf_net S_AXIS_1 [get_bd_intf_pins S_AXIS] \
    [get_bd_intf_pins in_fifo/S_AXIS]
  connect_bd_intf_net -intf_net in_fifo_M_AXIS [get_bd_intf_pins in_fifo/M_AXIS] \
    [get_bd_intf_pins fir/S_AXIS_DATA]
  connect_bd_intf_net -intf_net fir_M_AXIS_DATA [get_bd_intf_pins fir/M_AXIS_DATA] \
    [get_bd_intf_pins gain/s_axis]
  connect_bd_intf_net -intf_net gain_m_axis [get_bd_intf_pins gain/m_axis] \
    [get_bd_intf_pins M_AXIS]
  connect_bd_net -net aclk_1 [get_bd_pins aclk] \
    [get_bd_pins in_fifo/s_axis_aclk] \
    [get_bd_pins fir/aclk] \
    [get_bd_pins gain/clk]
  connect_bd_net -net aresetn_1 [get_bd_pins aresetn] \
    [get_bd_pins in_fifo/s_axis_aresetn] \
    [get_bd_pins gain/rst_n]

  current_bd_instance $oldCurInst
}

