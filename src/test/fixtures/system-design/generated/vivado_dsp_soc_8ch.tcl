  create_bd_pin -dir I -type clk dsp_clk
  create_bd_pin -dir I -type clk io_clk
  create_bd_pin -dir I -type rst ctrl_resetn
  create_bd_pin -dir I -type rst dsp_resetn
  create_bd_pin -dir I -type rst io_resetn
  create_bd_pin -dir O -type intr mm2s_irq
  create_bd_pin -dir O -type intr s2mm_irq

  set ctrl_sc [ create_bd_cell -type ip -vlnv xilinx.com:ip:smartconnect:1.0 ctrl_sc ]
  set_property -dict [list \
    CONFIG.NUM_SI {1} \
    CONFIG.NUM_MI {2} \
