        "type": "clk",
        "direction": "I",
        "parameters": {
          "FREQ_HZ": {
            "value": "125000000"
          },
          "PHASE": {
            "value": "0.0",
            "value_src": "default"
          }
        }
      },
      "sys_rst_n": {
        "type": "rst",
        "direction": "I"
      },
      "led_o": {
        "direction": "O",
        "left": "7",
        "right": "0"
      }
    },
    "components": {
      "sys_ps7": {
        "vlnv": "xilinx.com:ip:processing_system7:5.5",
        "xci_name": "zynq_gpio_system_sys_ps7_0",
        "parameters": {
          "PCW_FPGA0_PERIPHERAL_FREQMHZ": {
            "value": "100",
            "value_src": "user"
          },
          "PCW_MIO_TREE_PERIPHERALS": {
            "value": [
              "GPIO#Quad SPI Flash#Quad SPI",
              "Flash#UART 1"
            ]
          },
          "PCW_USE_M_AXI_GP0": {
            "value": "1",
            "value_src": "default"
          }
        },
        "interface_ports": {
          "M_AXI_GP0": {
            "mode": "Master",
            "vlnv": "xilinx.com:interface:aximm_rtl:1.0"
          }
        }
      },
      "axi_periph": {
        "vlnv": "xilinx.com:ip:axi_interconnect:2.1",
        "xci_name": "zynq_gpio_system_axi_periph_0",
        "parameters": {
          "NUM_MI": {
            "value": "2"
          }
        },
        "ports": {
          "ACLK": {
            "type": "clk",
            "direction": "I"
          }
        },
        "components": {
          "xbar": {
            "vlnv": "xilinx.com:ip:axi_crossbar:2.1",
            "xci_name": "zynq_gpio_system_xbar_0"
          }
        },
        "nets": {
          "inner_clk": {
            "ports": [
              "ACLK",
              "xbar/aclk"
            ]
          }
        }
      },
      "gpio_block": {
        "interface_ports": {
          "S_AXI": {
            "mode": "Slave",
            "vlnv": "xilinx.com:interface:aximm_rtl:1.0"
          },
          "GPIO": {
            "mode": "Master",
            "vlnv": "xilinx.com:interface:gpio_rtl:1.0"
          },
          "S_AXI_0": {
            "mode": "Slave",
            "vlnv": "xilinx.com:interface:aximm_rtl:1.0"
          }
        },
        "ports": {
          "clk": {
            "type": "clk",
            "direction": "I"
          },
          "rst_n": {
            "type": "rst",
            "direction": "I"
          }
        },
        "components": {
          "axi_gpio_1": {
            "vlnv": "xilinx.com:ip:axi_gpio:2.0",
            "xci_name": "zynq_gpio_system_axi_gpio_1",
            "parameters": {
              "C_ALL_OUTPUTS": {
                "value": "1"
              }
            }
          },
          "axi_gpio_0": {
            "vlnv": "xilinx.com:ip:axi_gpio:2.0",
            "xci_name": "zynq_gpio_system_axi_gpio_0",
            "parameters": {
              "C_GPIO_WIDTH": {
                "value": "8"
              }
            },
            "interface_ports": {
              "S_AXI": {
                "mode": "Slave",
                "vlnv": "xilinx.com:interface:aximm_rtl:1.0"
              }
            }
          }
        },
        "interface_nets": {
          "gpio_axi": {
            "interface_ports": [
              "S_AXI",
              "axi_gpio_1/S_AXI"
            ]
          },
          "gpio_pins": {
            "interface_ports": [
              "axi_gpio_1/GPIO",
              "GPIO"
            ]
          },
          "gpio_axi_0": {
            "interface_ports": [
              "S_AXI_0",
              "axi_gpio_0/S_AXI"
            ]
          }
        },
        "nets": {
          "block_clk": {
            "ports": [
              "clk",
              "axi_gpio_1/s_axi_aclk",
              "axi_gpio_0/s_axi_aclk"
            ]
          },
          "block_rst": {
            "ports": [
              "rst_n",
              "axi_gpio_1/s_axi_aresetn"
            ]
          }
        }
      },
      "sync_0": {
        "vlnv": "xilinx.com:module_ref:reset_synchronizer:1.0",
        "xci_name": "zynq_gpio_system_sync_0_0",
        "reference_info": {
          "ref_type": "hdl",
          "ref_name": "reset_synchronizer",
          "boundary_crc": "0x0"
        },
        "ports": {
          "clk": {
            "type": "clk",
            "direction": "I"
          },
          "rst_n": {
            "type": "rst",
            "direction": "O"
          }
        }
      }
    },
    "interface_nets": {
      "ps_axi": {
        "interface_ports": [
