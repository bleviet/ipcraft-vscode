          "sync_0/rst_n_in",
          "ghost_ctrl/rst_n"
        ]
      }
    },
    "addressing": {
      "/sys_ps7": {
        "address_spaces": {
          "Data": {
            "segments": {
              "SEG_axi_gpio_0_Reg": {
                "address_block": "/gpio_block/axi_gpio_0/S_AXI/Reg",
                "offset": "0x41200000",
                "range": "64K"
              },
              "SEG_axi_gpio_1_Reg": {
                "address_block": "/gpio_block/axi_gpio_1/S_AXI/Reg",
                "offset": "0x41210000",
                "range": "64K"
              },
              "SEG_axi_gpio_0_Mem": {
                "address_block": "/gpio_block/axi_gpio_0/S_AXI/Mem",
                "offset": "0x00000000",
                "range": "4G"
              },
              "SEG_axi_gpio_2_Reg": {
                "address_block": "/gpio_block/axi_gpio_0/S_AXI/Reg2",
                "offset": "0x41220000",
                "range": "4K",
                "is_excluded": "TRUE"
              },
              "SEG_axi_gpio_3_Reg": {
                "address_block": "/gpio_block/axi_gpio_0/S_AXI/Reg3",
                "offset": "0x41230000",
