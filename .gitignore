# Real-world parser fixtures — fetched at test time, never committed.
.test-fixtures/
# Belt-and-braces: block loose specimens anywhere in the tree.
**/*_hw.tcl
**/component.xml
# ...except examples/: these are real, hardware-validated IPCraft output
# committed on purpose (see examples/README.md), not test fixtures.
!examples/**/*_hw.tcl
!examples/**/component.xml

# examples/ — Quartus/Platform Designer/cocotb build artifacts (regenerated
# by `make sim` / `make qsys project compile`; see each example's
# altera/quartus/Makefile).
examples/**/db/
examples/**/incremental_db/
**/.qsys_edit/
examples/**/output_files/
examples/**/*.qsys
!examples/regmap_conformance_avmm/altera/test.qsys
!examples/regmap_conformance_axil/altera/test.qsys
examples/**/*.sopcinfo
examples/**/*_system_gen/
examples/**/*.sof
examples/**/*.qpf
examples/**/*.qsf
examples/**/*.qws
examples/**/*.rpt
examples/**/*.summary
examples/**/*.done
examples/**/*.smsg
examples/**/*.jdi
examples/**/*.pin
examples/**/*.sld
examples/**/*.elf
examples/**/software/platform/*/bsp/
examples/**/software/platform/*/build/
examples/**/tb/sim_build/
examples/**/tb/__pycache__/
examples/**/debug/__pycache__/
examples/**/tb/results.xml
examples/**/tb/*.ghw
examples/**/quartus/?/
examples/**/*_dump.txt

# examples/ — Vivado project written by xilinx/system/build_system.tcl (the IP
# core's own builds go to xilinx/build/, ignored above).
examples/**/xilinx/system/*.xpr
examples/**/xilinx/system/*.cache/
examples/**/xilinx/system/*.gen/
examples/**/xilinx/system/*.hw/
examples/**/xilinx/system/*.ip_user_files/
examples/**/xilinx/system/*.runs/
examples/**/xilinx/system/*.sim/
examples/**/xilinx/system/*.srcs/
examples/**/.Xil/

# Local isolated agent worktrees.
.worktrees/
